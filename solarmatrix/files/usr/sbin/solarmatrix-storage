#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# SolarMatrix storage management utility. Mounting and unmounting go through
# storage.sh, so the CLI follows the same fail-closed rules as boot.

. "${SOLARMATRIX_LIB:-/lib/solarmatrix}/storage.sh"

NVME_PART=/dev/nvme0n1p1
MOUNT_POINT="${SOLARMATRIX_MOUNT_POINT:-/solarmatrix}"

show_status() {
	local line
	echo "=== SolarMatrix Storage Status ==="
	line="$(grep -F " $MOUNT_POINT " "$SM_MOUNTS" 2>/dev/null | head -n 1)"
	if [ -n "$line" ]; then
		echo "Status: MOUNTED"
		echo "Device: ${line%% *}"
		echo "Mount Point: $MOUNT_POINT"
		echo "Usage: $(df -h "$MOUNT_POINT" | tail -n 1 | awk '{printf "%s / %s (%s full)", $3, $2, $5}')"
	else
		echo "Status: NOT MOUNTED"
		echo "Mount Point: $MOUNT_POINT"
	fi
}

# Read-only: shows what blkid reports, never mounts anything.
list_devices() {
	local device
	echo "=== Available NVMe Devices ==="
	for device in /dev/nvme*n*; do
		[ -b "$device" ] || continue
		echo "$device: $(blkid -s TYPE -o value "$device" 2>/dev/null || true) ($(blockdev --getsize64 "$device" 2>/dev/null || echo '?') bytes)"
	done
}

do_mount() {
	if sm_storage_mount "$NVME_PART" "$MOUNT_POINT"; then
		echo "Mounted $MOUNT_POINT"
		return 0
	fi
	echo "Not mounted; see logread -e solarmatrix-storage" >&2
	return 1
}

do_unmount() {
	sm_storage_umount "$MOUNT_POINT"
	echo "Unmounted $MOUNT_POINT"
}

show_help() {
	cat << 'HELP'
SolarMatrix Storage Management Utility

Usage: solarmatrix-storage <command>

Commands:
  status    - Show current mount status
  list      - List NVMe devices
  info      - Show status + list devices
  mount     - Mount the NVMe (same rules as boot)
  umount    - Unmount and close the encrypted volume
  remount   - Unmount and mount again
  help      - Show this help message

Logs: logread -e solarmatrix-storage
HELP
}

case "${1:-}" in
status)         show_status ;;
list)           list_devices ;;
info)           show_status; echo; list_devices ;;
mount)          do_mount ;;
umount|unmount) do_unmount ;;
remount)        do_unmount; do_mount ;;
help|--help|-h) show_help ;;
*)
	echo "Error: Unknown command '${1:-}'" >&2
	echo >&2
	show_help >&2
	exit 1
	;;
esac
