#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Makes root unauthenticable over the network.
#
# The device still has a unique, strong root password -- it is written to
# /solarmatrix/config.json during provisioning and applied to the account --
# but after this script has run, dropbear will not accept it, or any other
# password, from the network. Root remains reachable through OpenWrt failsafe
# mode, which needs physical access to the device: failsafe starts its own
# dropbear from /lib/preinit/99_10_failsafe_dropbear with an explicit command
# line and reads none of the configuration touched here.
#
# The provisioning tool runs this as its last step. Run it by hand after any
# recovery that reset the configuration -- see docs/RECOVERY.md in the
# provisioning repository.

set -e

uci set dropbear.@dropbear[0].PasswordAuth='off'
uci set dropbear.@dropbear[0].RootPasswordAuth='off'
uci set dropbear.@dropbear[0].DirectInterface='lan'
uci commit dropbear

# Read the settings back. A security control that quietly failed to apply is
# worse than one that was never attempted, so refuse to report success on it.
for opt in PasswordAuth RootPasswordAuth; do
	val="$(uci -q get "dropbear.@dropbear[0].$opt")" || val='(unset)'
	if [ "$val" != "off" ]; then
		echo "solarmatrix-harden-ssh: dropbear $opt is '$val', expected 'off'" >&2
		exit 1
	fi
done

service dropbear restart

echo "SSH password authentication disabled; root is reachable only via failsafe mode."
