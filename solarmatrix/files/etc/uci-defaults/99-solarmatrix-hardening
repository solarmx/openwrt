#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Establishes the device's access posture from immutable storage. It runs from
# /etc/init.d/boot (START=10), before dropbear (START=19) binds a socket, on
# every boot that follows a configuration wipe -- and on the NOR recovery
# system, an initramfs, that is every boot.
#
# Authority is the factory-secrets NOR partition (/lib/solarmatrix/secrets.sh),
# which no configuration wipe touches:
#
#   empty    unprovisioned. On NOR, SSH accepts only the provisioning key.
#   valid    provisioned. On NOR, SSH accepts only this unit's own keys.
#   corrupt  fail closed: no SSH key is accepted anywhere.
#
# A valid image whose JSON does not parse, or that carries no SSH keys, is
# treated like corrupt for SSH: no key, never the provisioning key.
#
# On NAND dropbear never starts, whatever the state. Root has no usable
# password in any state.
#
# Secrets never reach argv (visible in ps): the JSON reaches jsonfilter on
# stdin, and every UCI value reaches uci through `uci batch` on stdin.
#
# Deliberately no `set -e`: one failed concern must not skip the rest. A
# non-zero exit leaves this script in place, so the next boot tries again.

. "${SOLARMATRIX_LIB:-/lib/solarmatrix}/secrets.sh"

SHADOW="${SOLARMATRIX_SHADOW:-/etc/shadow}"
AUTH_KEYS="${SOLARMATRIX_AUTH_KEYS:-/etc/dropbear/authorized_keys}"
PROV_KEY="${SOLARMATRIX_PROVISIONING_KEY:-/etc/solarmatrix/provisioning.pub}"
MOUNTS="${SOLARMATRIX_MOUNTS:-/proc/mounts}"

failed=0

crit() {
	logger -t solarmatrix-hardening -p daemon.crit "$1"
	echo "solarmatrix-hardening: $1" >&2
	failed=1
}

# Sets a UCI option, commits its package, and reads it back. The value goes
# to uci on stdin, single-quoted for uci's parser, and is never logged,
# because some values (the WiFi key) are secret. printf is an ash builtin, so
# it puts nothing in argv either.
uci_set_verified() {
	local key="$1" want="$2" quoted got=''
	quoted="$(printf '%s' "$want" | sed "s/'/'\\\\''/g")"
	printf "set %s='%s'\n" "$key" "$quoted" | uci batch 2>/dev/null
	uci commit "${key%%.*}" 2>/dev/null
	got="$(uci -q get "$key")" || got=''
	[ "$got" = "$want" ] && return 0
	crit "$key did not take"
	return 1
}

# json_get EXPR: prints what jsonfilter finds in $json, fed on stdin.
json_get() {
	printf '%s' "$json" | jsonfilter -e "$1" 2>/dev/null
}

# The NOR recovery system is an initramfs, so the last "/" in the mount table
# is rootfs or tmpfs; on NAND it is the overlay. Anything else, including an
# unreadable table, counts as NAND: a wrong guess then costs SSH, not safety.
boot_medium() {
	if awk '$2 == "/" { t = $3 } END { exit !(t == "rootfs" || t == "tmpfs") }' "$MOUNTS" 2>/dev/null; then
		echo nor
	else
		echo nand
	fi
}

# Replaces AUTH_KEYS atomically with the given content (from stdin).
install_auth_keys() {
	if ! { mkdir -p "$(dirname "$AUTH_KEYS")" && cat > "$AUTH_KEYS.new" &&
		chmod 600 "$AUTH_KEYS.new" && mv "$AUTH_KEYS.new" "$AUTH_KEYS"; }; then
		crit "could not write $AUTH_KEYS"
	fi
}

# --- Concern 1: root has no usable password ---------------------------------
# `*` matches no password but, unlike `!`, does not make dropbear treat the
# account as locked, so key login on NOR still works. Written back through
# cat so the file keeps its owner and mode.
sed 's/^root:[^:]*:/root:*:/' "$SHADOW" > "$SHADOW.new" && cat "$SHADOW.new" > "$SHADOW"
rm -f "$SHADOW.new"
grep -q '^root:\*:' "$SHADOW" || crit "root password field is not '*'"

# --- Concern 2: the serial console never logs in without a password ---------
# /etc/inittab ships without a login line; this is the second layer.
uci_set_verified 'system.@system[0].ttylogin' '1'

# --- Concern 3: no wildcard-bound web server --------------------------------
if uci -q show uhttpd >/dev/null 2>&1; then
	service uhttpd disable || crit "could not disable uhttpd"
fi

# --- Concern 4: read the unit's state ---------------------------------------
dev="$(sm_secrets_dev)" || dev=''
state="$(sm_secrets_state "$dev")"
json=''
[ "$state" = valid ] && json="$(sm_secrets_json "$dev")"
[ "$state" = corrupt ] && crit "factory-secrets is unreadable or corrupt; failing closed"

# --- Concern 5: SSH exists only on NOR, key-only -----------------------------
if [ "$(boot_medium)" = nor ]; then
	uci_set_verified 'dropbear.@dropbear[0].enable' '1'
	uci_set_verified 'dropbear.@dropbear[0].PasswordAuth' 'off'
	uci_set_verified 'dropbear.@dropbear[0].RootPasswordAuth' 'off'
	uci_set_verified 'dropbear.@dropbear[0].DirectInterface' 'lan'
	case "$state" in
	empty)
		if [ -s "$PROV_KEY" ]; then
			install_auth_keys < "$PROV_KEY"
		else
			crit "unprovisioned but $PROV_KEY is missing; no SSH key accepted"
			install_auth_keys < /dev/null
		fi
		;;
	valid)
		keys="$(json_get '@.ssh_keys[*]')" || keys=''
		if [ -n "$keys" ]; then
			printf '%s\n' "$keys" | install_auth_keys
		else
			crit "factory-secrets carries no SSH keys or does not parse; no SSH key accepted"
			install_auth_keys < /dev/null
		fi
		;;
	*)
		install_auth_keys < /dev/null
		;;
	esac
else
	uci_set_verified 'dropbear.@dropbear[0].enable' '0'
	install_auth_keys < /dev/null
fi

# --- Concern 6: WiFi credentials come from the secrets, or the APs stay down -
sections="$(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p')"
ssid=''; wkey=''
if [ "$state" = valid ]; then
	ssid="$(json_get '@.wifi.ssid')" || ssid=''
	wkey="$(json_get '@.wifi.key')" || wkey=''
	if [ -z "$ssid" ] || [ -z "$wkey" ]; then
		crit "factory-secrets has no complete WiFi credentials; APs stay down"
		ssid=''; wkey=''
	fi
fi
for section in $sections; do
	if [ -n "$wkey" ]; then
		uci_set_verified "wireless.$section.ssid" "$ssid"
		uci_set_verified "wireless.$section.key" "$wkey"
		uci_set_verified "wireless.$section.encryption" 'psk2'
		uci_set_verified "wireless.$section.disabled" '0'
	else
		uci_set_verified "wireless.$section.disabled" '1'
	fi
done

[ "$failed" = 0 ] || exit 1
exit 0
