#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# Mounts the SolarMatrix NVMe at boot; the decision lives in storage.sh.

START=20
STOP=90

NVME_PART=/dev/nvme0n1p1
MOUNT_POINT=/solarmatrix

start() {
	[ -b "$NVME_PART" ] || return 0
	. "${SOLARMATRIX_LIB:-/lib/solarmatrix}/storage.sh"
	sm_storage_mount "$NVME_PART" "$MOUNT_POINT"
}

stop() {
	. "${SOLARMATRIX_LIB:-/lib/solarmatrix}/storage.sh"
	sm_storage_umount "$MOUNT_POINT"
}
