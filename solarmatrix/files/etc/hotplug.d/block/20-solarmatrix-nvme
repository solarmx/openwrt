#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Mounts the SolarMatrix NVMe partition when it appears after boot; the
# decision lives in storage.sh.

[ "$DEVICENAME" = nvme0n1p1 ] || exit 0
. "${SOLARMATRIX_LIB:-/lib/solarmatrix}/storage.sh"

case "$ACTION" in
add)    sm_storage_mount "/dev/$DEVICENAME" /solarmatrix ;;
remove) sm_storage_umount /solarmatrix ;;
esac
exit 0
