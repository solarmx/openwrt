#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Mounts the SolarMatrix NVMe partition when it appears after boot; the
# decision lives in storage.sh.

[ "$DEVICENAME" = nvme0n1p1 ] || exit 0
. "${SOLARMATRIX_LIB:-/lib/solarmatrix}/storage.sh"
MOUNT_POINT="${SOLARMATRIX_MOUNT_POINT:-/solarmatrix}"

case "$ACTION" in
add)    sm_storage_mount "/dev/$DEVICENAME" "$MOUNT_POINT" ;;
remove) sm_storage_umount "$MOUNT_POINT" ;;
esac
exit 0
